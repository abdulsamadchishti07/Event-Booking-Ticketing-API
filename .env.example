# Database Url
DATABASE_URL =  postgresql://user:password@localhost:5432/dbname

# JWT
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (Gmail SMTP)
EMAIL_HOST_USER=abdulsamadchishti07@gmail.com
EMAIL_HOST_PASSWORD=your app password
DEFAULT_FROM_EMAIL=abdulsamadchishti07@gmail.com
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Redis
REDIS_URL=redis://localhost:6379/0

# Stripe
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_here

# Environment & Security
ENVIRONMENT=development
# In Docker/production behind Nginx/reverse proxy, add your proxy's internal subnet, e.g.:
# TRUSTED_PROXIES=127.0.0.1,::1,localhost,testclient,172.16.0.0/12,10.0.0.0/8
TRUSTED_PROXIES=127.0.0.1,::1,localhost,testclient

# Rate Limiting (Default strict production limits; raise to 100000 for single-machine stress benchmarks)
SERVICES_RATE_LIMIT=120
BOOKINGS_RATE_LIMIT=60
PAYMENTS_RATE_LIMIT=60
AUTH_RATE_LIMIT=100
MAX_CONCURRENT_AUTH_HASHES=10
RATE_LIMIT_FAIL_CLOSED=false # Set to true to return 503 instead of failing open when Redis is down

# Database Connection Pool Settings
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=25
DB_POOL_TIMEOUT=10
